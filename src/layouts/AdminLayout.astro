---
interface Props {
	title?: string;
}

const { title = "管理后台" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#5b5bd6" />
		<title>{title} - Xuanji's Blog</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		font-family:
			Inter, "Microsoft YaHei", "PingFang SC", system-ui, -apple-system,
			sans-serif;
		background: #f5f6fb;
		color: #25263a;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		background:
			radial-gradient(circle at 20% 0%, rgba(91, 91, 214, 0.1), transparent 28rem),
			#f5f6fb;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}
</style>
